ANTHROPIC_API_KEY=sk-ant-...

# Authentication
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Optional: affiliate IDs appended to every booking link
SKYSCANNER_ASSOCIATE_ID=
BOOKING_AFFILIATE_ID=
GETYOURGUIDE_PARTNER_ID=

# How often the background price watcher runs (seconds). Defaults to 3600 with live
# price keys set, 300 without.
# WATCH_INTERVAL_SECONDS=3600

# Live prices (optional; without them prices are simulated estimates)
# Flights: https://duffel.com (Dashboard > Developers > Access tokens)
DUFFEL_ACCESS_TOKEN=
# Hotels: https://liteapi.travel (Dashboard > Profile > sandbox key)
LITEAPI_KEY=
